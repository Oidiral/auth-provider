# Application
APP_HOST=0.0.0.0
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s
APP_MAX_HEADER_MEGABYTES=1

# Authentication
AUTH_VERIFICATION_CODE_LENGTH=6

# JWT
accessTokenTTL=1h
refreshTokenTTL=72h
signingKey=secret

# Rate Limiting
RPS=1000
BURST=1000
TTL=1h

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_PASS=

# AI - Anthropic Claude
ANTHROPIC_API_KEY=
